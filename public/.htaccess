# Control de la memòria cau del servidor (Hostinger/LiteSpeed).
#
# Problema que resol: per defecte el servidor serveix els .js i .json amb
# "max-age=604800" (7 dies). Els fitxers de DADES de l'edició canvien 4 cops
# al dia, i una còpia envellida a la cau feia que la portada mostrés
# l'edició anterior encara que el desplegament hagués anat bé.
#
# Regla: les dades de l'edició es revaliden sempre (no-cache fa servir
# Last-Modified i respon 304 si no hi ha canvis: barat i sempre fresc).
# Les imatges i els àudios, que no canvien mai un cop publicats, poden
# quedar-se a la cau tant de temps com calgui.

<IfModule mod_headers.c>
# Prova d'origen de WebMCP a Chrome (registrada l'11.10.2026 amb el compte de
# Rafael; origen https://inteligencia-artificial.cat, sense subdominis).
# Activa document.modelContext perquè funcionin les eines de /webmcp.js.
# NO és cap secret: Chrome el vol a la vista a cada pàgina. CADUCA el
# 30.03.2027 (o abans, si Chrome tanca la prova): renovar-lo a
# https://developer.chrome.com/origintrials/ («My Registrations» → WebMCP →
# «Renew») i substituir-lo aquí. Si caduca, el web continua igual i les
# eines simplement no s'activen.
Header set Origin-Trial "Ap2Z/GkS6fdk35uhBaZhZGttzLUafppVkdeLAtC5tSaxiI2WOUYSiIxzhHR7GEGg6AGEmSIZvUhTPkQi9jO/UA8AAABbeyJvcmlnaW4iOiJodHRwczovL2ludGVsaWdlbmNpYS1hcnRpZmljaWFsLmNhdDo0NDMiLCJmZWF0dXJlIjoiV2ViTUNQIiwiZXhwaXJ5IjoxODA2MzY0ODAwfQ=="
# 12.10.2026: també les peces manuals (tribuna, estudis, sèries), que la CDN
# servia velles fins a una hora després de publicar-ne una de nova.
<FilesMatch "^(news|radar|analysis|reflection|daily-image|tribuna|tribuna-arxiu|estudis|estudis-arxiu|series|empresa)\.js$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.json$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(html|php|txt)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|mp3)$">
Header set Cache-Control "public, max-age=2592000, immutable"
</FilesMatch>
# Tipografies pròpies (des del 07.08.2026 ja no es demanen a Google): no canvien
# mai un cop publicades, així que poden quedar-se a la cau un any.
<FilesMatch "\.(woff2|woff)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

# Textos plans en UTF-8 (11.10.2026): sense això, llms.txt i robots.txt podien
# sortir sense joc de caràcters i un agent llegiria «intelÂ·ligÃ¨ncia».
# (Només AddCharset, de mod_mime: el mateix nivell de permís que ja fan servir
# les regles de reescriptura, i no toca cap altra resposta del web.)
<IfModule mod_mime.c>
AddCharset UTF-8 .txt .md
</IfModule>

# Fitxers privats de dades: mai no s'han de poder descarregar per HTTP.
# (api.php hi accedeix pel sistema de fitxers; això només bloqueja el web.)
<Files "subscribers.csv">
Require all denied
</Files>
<Files "mail.log">
Require all denied
</Files>
# Club de lectura (08.10.2026): opinions dels lectors (pendents incloses) i clau
# de moderació. Només existeixen al servidor; api.php i club-modera.php hi
# accedeixen pel sistema de fitxers.
<FilesMatch "^club-(opinions\.json|opinions\.json\.tmp|opinions\.lock|secret\.txt)$">
Require all denied
</FilesMatch>
# Butlletí enviat des del web (17.10.2026): estat dels subscriptors, llista
# inicial, clau de les signatures, registre i bloquejos. Només al servidor.
<FilesMatch "^butlleti(-estat\.json|-estat\.json\.tmp|-estat\.lock|-confirmats\.txt|-secret\.txt|\.log|\.lock)$">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# Un únic host canònic: qualsevol altre nom (www o els dominis alternatius
# intel·ligencia-artificial.cat, intel·ligenciaartificial.cat,
# inteligenciaartificial.cat i intelligencia-artificial.cat) es redirigeix
# amb un 301 al domini bo, conservant el camí sencer.
RewriteCond %{HTTP_HOST} !^inteligencia-artificial\.cat$ [NC]
RewriteRule ^ https://inteligencia-artificial.cat%{REQUEST_URI} [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^news-sitemap\.xml$ news-sitemap.php [L]
RewriteRule ^feed\.xml$ feed.php [L]
# Agents d'IA (11.10.2026): /llms.txt és un fitxer estàtic (l'índex del web) i
# /llms-full.txt, l'edició del dia en Markdown, el genera llms-full.php.
RewriteRule ^llms-full\.txt$ llms-full.php [L]
RewriteRule ^tema/([a-z0-9-]+)/?$ tema.php?tema=$1 [L,QSA]

# Adreces fixes de les peces editorials (24.09.2026): /tribuna/<id>, /estudis/<id>,
# /analisi/<id>, /quadern/<id> i /reflexio/<AAAA-MM-DD>. Vegeu peca.php i inc/peces.php.
RewriteRule ^(tribuna|estudis|analisi|quadern|reflexio|empresa)/([a-z0-9-]+)/?$ peca.php?tipus=$1&id=$2 [L,QSA]

# Seccions de servei (24.09.2026).
RewriteRule ^autors/?$ autors.php [L,QSA]
RewriteRule ^autor/([a-z0-9-]+)/?$ autors.php?nom=$1 [L,QSA]
RewriteRule ^agenda/?$ agenda.php [L,QSA]
RewriteRule ^glossari/?$ glossari.php [L,QSA]
RewriteRule ^ecosistema/?$ ecosistema.php [L,QSA]
RewriteRule ^formacio/?$ formacio.php [L,QSA]
RewriteRule ^centres-de-dades/?$ centres-de-dades.php [L,QSA]
RewriteRule ^club-de-lectura/?$ club-de-lectura.php [L,QSA]
# Sèrie «Veus de CIVICAi» (12.10.2026): definició a series.js; peces amb "serie" a tribuna*.js i estudis*.js.
RewriteRule ^eixos/?$ eixos.php [L,QSA]
RewriteRule ^veus-de-civicai/?$ veus-de-civicai.php [L,QSA]
# Sèrie «Veus de l'administració» (20.10.2026): mateix mecanisme que CIVICAi.
RewriteRule ^veus-de-l-administracio/?$ veus-de-l-administracio.php [L,QSA]
# «Veus d'empresa» (15.10.2026): llista de la secció; les peces, a /empresa/<id> (peca.php).
RewriteRule ^veus-d-empresa/?$ veus-d-empresa.php [L,QSA]
# Vídeos (09.10.2026): dades a data/videos.json, generades pel workflow videos.yml.
RewriteRule ^videos/?$ videos.php [L,QSA]
# La IA a la ràdio (11.10.2026): fitxes MANUALS a data/radio.json.
RewriteRule ^radio/?$ radio.php [L,QSA]
# Ressò de premsa (10.10.2026): dades a data/premsa.json, generades pel workflow premsa.yml.
RewriteRule ^premsa/?$ premsa.php [L,QSA]
# L'edició d'avui (11.10.2026): totes les notícies del dia juntes (data/articles.json).
RewriteRule ^avui/?$ avui.php [L,QSA]
RewriteRule ^club-de-lectura/([a-z0-9-]+)/?$ club-de-lectura.php?llibre=$1 [L,QSA]
RewriteRule ^llengua/?$ llengua.php [L,QSA]
RewriteRule ^correccions/?$ correccions.php [L,QSA]
RewriteRule ^podcast\.xml$ podcast.php [L]

# Peces de codi compartit: no s'han de poder demanar directament.
RewriteRule ^inc/ - [F,L]

# URLs antigues: cada pàgina es redirigeix al nou equivalent temàtic.
RewriteRule ^ara/?$ https://inteligencia-artificial.cat/ [R=301,L]
RewriteRule ^onu/?$ https://inteligencia-artificial.cat/tema/poder-i-geopolitica [R=301,L]
RewriteRule ^economia/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^llms/?$ https://inteligencia-artificial.cat/tema/novetats-models-i-productes [R=301,L]
RewriteRule ^computacio/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^ia-i-politica/?$ https://inteligencia-artificial.cat/tema/poder-i-geopolitica [R=301,L]
RewriteRule ^ia-i-innovacio/?$ https://inteligencia-artificial.cat/tema/novetats-models-i-productes [R=301,L]
RewriteRule ^ia-i-societat/?$ https://inteligencia-artificial.cat/tema/societat-cultura-i-educacio [R=301,L]
RewriteRule ^ia-i-filosofia/?$ https://inteligencia-artificial.cat/tema/ment-etica-i-humanisme [R=301,L]
RewriteRule ^ia-i-educacio/?$ https://inteligencia-artificial.cat/dossiers.html [R=301,L]
RewriteRule ^ia-i-medi-ambient/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^salutia/?$ https://inteligencia-artificial.cat/tema/ciencia-salut-i-robotica [R=301,L]
RewriteRule ^tv3/?$ https://inteligencia-artificial.cat/tema/catalunya [R=301,L]
RewriteRule ^generalitat-de-catalunya/?$ https://inteligencia-artificial.cat/dossiers.html [R=301,L]
RewriteRule ^formacio/?$ https://inteligencia-artificial.cat/eines.html [R=301,L]
RewriteRule ^llibres-tecnics/?$ https://inteligencia-artificial.cat/dossiers.html [R=301,L]
RewriteRule ^salut/?$ https://inteligencia-artificial.cat/tema/ciencia-salut-i-robotica [R=301,L]
RewriteRule ^turisme/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^ciberseguretat/?$ https://inteligencia-artificial.cat/tema/riscos-seguretat-i-drets [R=301,L]
RewriteRule ^aigua/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^canvi-climatic/?$ https://inteligencia-artificial.cat/tema/economia-i-treball [R=301,L]
RewriteRule ^i2cat/?$ https://inteligencia-artificial.cat/tema/catalunya [R=301,L]
RewriteRule ^cidai/?$ https://inteligencia-artificial.cat/tema/catalunya [R=301,L]

# Restants del web antic detectats a Search Console (04.08.2026).
RewriteRule ^diversos/?$ https://inteligencia-artificial.cat/ [R=301,L]
RewriteRule ^la-importncia-de-la-intelligncia-artificial/?$ https://inteligencia-artificial.cat/tema/novetats-models-i-productes [R=301,L]
RewriteRule ^arquitectura/?$ https://inteligencia-artificial.cat/tema/novetats-models-i-productes [R=301,L]
RewriteRule ^ia-i-medicina/?$ https://inteligencia-artificial.cat/tema/ciencia-salut-i-robotica [R=301,L]
RewriteRule ^el-futur-de-la-intelligncia-artificial/?$ https://inteligencia-artificial.cat/tema/novetats-models-i-productes [R=301,L]

# Més URL antigues que Search Console donava com a 404 (07.10.2026).
RewriteRule ^oeiac/?$ https://inteligencia-artificial.cat/ecosistema [R=301,L]
RewriteRule ^podcasts/?$ https://inteligencia-artificial.cat/podcast.html [R=301,L]
RewriteRule ^industries-culturals/?$ https://inteligencia-artificial.cat/tema/societat-cultura-i-educacio [R=301,L]
RewriteRule ^fires-i-congressos/?$ https://inteligencia-artificial.cat/agenda [R=301,L]
# I una altra del web antic que Search Console va trobar el 12.10.2026.
RewriteRule ^oms/?$ https://inteligencia-artificial.cat/tema/ciencia-salut-i-robotica [R=301,L]

# Restes del WordPress antic (wp-login.php, wp-cron.php, wp-admin...):
# redirigides a la portada perquè deixin de comptar com a 404.
RewriteRule ^wp-[^/]*\.php$ https://inteligencia-artificial.cat/ [R=301,L]
RewriteRule ^wp-(admin|content|includes)(/.*)?$ https://inteligencia-artificial.cat/ [R=301,L]
</IfModule>
